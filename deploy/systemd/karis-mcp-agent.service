[Unit]
Description=Karis local VPS Desktop Commander MCP agent
Requires=karis-mcp-relay.service
After=karis-mcp-relay.service
[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/workspace/projects/desktop-commander-selfhost/source
EnvironmentFile=/home/ubuntu/workspace/projects/desktop-commander-selfhost/runtime/private/agent.env
ExecStart=/home/ubuntu/.nvm/versions/node/v22.23.3/bin/node dist/index.js remote --no-save
Restart=on-failure
RestartSec=8
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
LimitNOFILE=8192
[Install]
WantedBy=multi-user.target
